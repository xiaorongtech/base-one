user nginx;
worker_processes auto;
error_log /dev/stderr notice;
pid /run/app/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  access_log /dev/stdout;
  server_tokens off;
  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;

  # 非 root 运行时这些临时目录必须可写
  client_body_temp_path /run/app/nginx/client_temp;
  proxy_temp_path       /run/app/nginx/proxy_temp;
  fastcgi_temp_path     /run/app/nginx/fastcgi_temp;
  uwsgi_temp_path       /run/app/nginx/uwsgi_temp;
  scgi_temp_path        /run/app/nginx/scgi_temp;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  server {
    listen 8080 default_server;
    listen [::]:8080 default_server;

    root /run/app/www;
    index index.html;

    # 健康检查：容器探针用
    location = /healthz {
      default_type text/plain;
      return 200 "ok\n";
    }

    # 节点参数只挂在 WS 路径前缀下，不做全站公开
    location = ${WS_PATH}/node.json {
      alias /run/app/www/node.json;
      default_type application/json;
      add_header Cache-Control "no-store";
    }

    location = ${WS_PATH} {
      proxy_pass http://127.0.0.1:10000;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Forwarded-Proto "";
      proxy_buffering off;
      proxy_redirect off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
